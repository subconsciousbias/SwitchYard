# Attaches Switchyard's own OAuth bearer to a caller's request and forwards it
# untouched. One image, one service per provider (SWITCHYARD_PROVIDER).
#
# Deliberately not the sidecar image: no vendor CLI, no node, nothing that could
# start an agent harness. The whole value of this path is that the caller's
# `tools` reach the model unaltered, so the less this container can do, the
# better. It needs Python, httpx and the token store — nothing else.
FROM python:3.12-slim

WORKDIR /app
COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

COPY sidecars/token_proxy/server.py /app/token_proxy/server.py
# The refresh logic lives with the login command, so the proxy and the CLI that
# minted the grant can never disagree about the token's shape or its expiry.
COPY switchyard/oauth.py /app/switchyard/oauth.py
COPY switchyard/__init__.py /app/switchyard/__init__.py

# /app/secrets is the mount for ./secrets/xai, which holds oauth.json. It is
# the same file the host's `python3 -m switchyard.oauth login` writes. The
# mount is scoped to this directory on purpose: the other ./secrets/<provider>
# stores (claude, codex, opencode, ...) are unrelated to this container.
ENV SWITCHYARD_PROVIDER=xai \
    SWITCHYARD_AUTH_STORE=/app/secrets/oauth.json \
    SWITCHYARD_PLANS=/app/config/plans.yaml \
    PYTHONPATH=/app

EXPOSE 8090 8091
# `exec uvicorn` so uvicorn replaces sh as PID 1 and receives SIGTERM directly
# when docker compose stop sends it (issue #131: with sh as PID 1 the signal
# reached sh, not uvicorn, and the sidecar took the full stop_grace_period to
# die). The `cd /app/token_proxy` still runs under sh first, so the
# `${PROXY_PORT}` variable expansion resolves before the exec. The
# `--timeout-graceful-shutdown 30` flag bounds uvicorn's own drain well
# inside compose's 45s stop_grace_period.
CMD ["sh", "-c", "cd /app/token_proxy && exec uvicorn server:app --host 0.0.0.0 --port ${PROXY_PORT:-8090} --timeout-graceful-shutdown 30"]
