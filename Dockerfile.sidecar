# Owns the vendor CLIs and their OAuth credentials. One image, three services:
#   PROVIDER=claude  -> Claude Max        (claude -p)
#   PROVIDER=codex   -> ChatGPT seat      (codex exec)
#   PROVIDER=opencode -> SuperGrok / OpenCode Go (opencode run)
# Mount the host's credential directory so each CLI uses a login you already
# have; this image never handles a token itself. Connection limits and model
# aliases are read from config/plans.yaml at runtime, not baked in here.
FROM node:22-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 python3-pip git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Pinned on purpose. These are agent harnesses, and the bridge depends on the
# exact behaviour of each: the flags it passes, the JSON event shape it parses,
# what its MCP client names a tool, and how long that client will hold a tool
# call open before timing it out. An unpinned `npm install -g` re-resolves to
# whatever is newest at build time, so an unrelated rebuild could silently swap
# the CLI under a verified profile -- exactly how a starlette bump quietly broke
# the portal. Raise these deliberately, then re-run the checks in TESTING.md
# (section 4i covers the tool-path lockdown).
RUN npm install -g \
      @anthropic-ai/claude-code@2.1.278 \
      @openai/codex@0.155.1 \
      opencode-ai@1.18.31

WORKDIR /app
# Both bridges ship in every sidecar image and BRIDGE picks one at runtime, so a
# plan can move between the text path and the tool path without a rebuild. They
# must stay siblings: mcp_bridge imports cli_bridge's argv building and error
# classification rather than duplicating them.
COPY sidecars/cli_bridge/server.py /app/cli_bridge/server.py
COPY sidecars/mcp_bridge /app/mcp_bridge
# Both bridges need switchyard/caller_env.py: it owns the per-request
# resolution of the caller's tool-execution environment (issue #44) and
# the rendering of the [SwitchYard tool execution environment] block the
# inner CLI sees. switchyard/models.py ships alongside it because the
# bridges build CallerEnvironmentSettings from plans.yaml's
# settings.caller_environment (issue #44 + operator config); dropping
# it would silently turn caller_environment config into None at runtime.
# Mirrors Dockerfile.token_proxy's switchyard/ copy: PYTHONPATH=/app +
# the package on disk makes `import switchyard.caller_env` and
# `import switchyard.models` work the same way `import switchyard.oauth`
# does in the token-proxy image. Import-time deps are stdlib + pyyaml
# only -- litellm is a lazy guarded import inside
# `litellm_known_vision_models()`, so a plain `import switchyard.models`
# in the build-time assertion below cannot accidentally pull litellm in.
COPY switchyard/__init__.py /app/switchyard/__init__.py
COPY switchyard/caller_env.py /app/switchyard/caller_env.py
COPY switchyard/models.py /app/switchyard/models.py
# Minimal harness configs. opencode.json defines the `switchyard` agent (every
# built-in tool hidden AND denied at the permission layer); the bridges write
# the same config (cli_bridge.opencode_config) into each spawn directory,
# because OpenCode reads its project config from the working directory.
# codex-instructions.md is the default base-instruction override.
# Together these are what makes a subscription viable for volume: they cut the
# CLI's own prompt from thousands of tokens per call to hundreds.
COPY sidecars/cli_bridge/harness /app/harness
RUN cp /app/harness/opencode.json /app/opencode.json
RUN pip install --no-cache-dir --break-system-packages \
      fastapi "uvicorn[standard]" pyyaml
# Build-time assertion: the COPY above lands switchyard/models.py in the
# image; an edit that drops the COPY (or a copy of the wrong file) would
# silently turn caller_environment config into None on every request. The
# same WORKDIR=/app + `python3 -c "..."` pattern Dockerfile.gateway uses
# for its package audit (Dockerfile.gateway:24-42): cwd is on sys.path,
# so a plain `import switchyard.models` resolves the module we just
# copied, and a constructor call proves the typed surface (probe, etc.)
# shipped intact. The ENV PYTHONPATH=/app directive below then makes the
# same import work at container run time.
RUN cd /app && python3 -c "import switchyard.models; assert switchyard.models.CallerEnvironmentSettings(probe='required').probe == 'required'"

# Pre-create the node-owned XDG tree so the daemon never has to root-create the
# mount parents. When the host's /home/node exists but a child like .local/share
# or .config/opencode does not, Docker materialises the missing dir as
# root:root at container creation; that's harmless when the daemon runs as root
# (pre-#223), but compose runs as `user: node` (uid 1000), so the first opencode
# call hits EACCES on `.local/share`/`.config/opencode` bind-mount parents. Bake
# the four dirs in node-owned and the mounts land on a writable path.
RUN mkdir -p /home/node/.local/state /home/node/.local/share /home/node/.config /home/node/.cache \
    && chown -R node:node /home/node/.local /home/node/.config /home/node/.cache

# Roots the tool path may recreate the caller's working directory under
# (mcp_bridge.MIRROR_ROOTS). Claude Code and OpenCode report their own cwd,
# git state and shell to the model in a block no flag removes on a
# subscription login; running them in an empty directory at the caller's own
# path makes that block agree with the caller instead of contradicting it
# (issue #264). Sticky + world-writable so the unprivileged `node` user can
# create the path, and nobody can remove another's; /home/node itself keeps
# its owner and is excluded by MIRROR_DENY.
RUN mkdir -p /Users /workspace /workspaces /srv /mnt /projects /code /data \
    && chmod 1777 /Users /home /workspace /workspaces /srv /mnt /projects /code /data

# The container runs as root, so $HOME is /root — but the host credential
# directories are mounted under /home/node. Claude and Codex are pinned by
# CLAUDE_CONFIG_DIR / CODEX_HOME and were unaffected, but OpenCode resolves
# XDG paths from $HOME and so looked in /root, finding zero credentials while a
# perfectly good login sat mounted a directory away. Point HOME and the XDG
# variables at the mounts.
ENV HOME=/home/node \
    XDG_DATA_HOME=/home/node/.local/share \
    XDG_CONFIG_HOME=/home/node/.config \
    XDG_CACHE_HOME=/home/node/.cache \
    XDG_STATE_HOME=/home/node/.local/state

ENV PROVIDER=claude SWITCHYARD_PLANS=/app/config/plans.yaml PYTHONPATH=/app
EXPOSE 8081 8082 8083 8084
# `exec uvicorn` so uvicorn replaces sh as PID 1 and receives SIGTERM directly
# when docker compose stop sends it (issue #131: with sh as PID 1 the signal
# reached sh, not uvicorn, and the sidecar took the full stop_grace_period to
# die). The `cd /app/${BRIDGE:-cli}_bridge` still runs under sh first, so the
# variable expansion on `${BRIDGE}` / `${SIDECAR_PORT}` resolves before the
# exec, and uvicorn inherits the session-workdir-style cwd. The
# `--timeout-graceful-shutdown 30` flag bounds uvicorn's own drain so the
# mcp_bridge cleanup path (release parked futures / turns / CLI subprocesses)
# finishes well inside compose's 45s stop_grace_period.
CMD ["sh", "-c", "cd /app/${BRIDGE:-cli}_bridge && exec uvicorn server:app --host 0.0.0.0 --port ${SIDECAR_PORT:-8081} --timeout-graceful-shutdown 30"]
