{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "*": "allow",
      ".env": "deny",
      ".env.backup.*": "deny",
      "secrets/**": "deny"
    },
    "edit": {
      "*": "allow",
      ".env": "deny",
      ".env.backup.*": "deny"
    },
    "bash": {
      "*": "allow",
      "*docker compose build *": "deny",
      "*docker compose build": "deny",
      "*docker compose up *": "deny",
      "*docker compose up": "deny",
      "*docker login *": "deny",
      "*docker login": "deny",
      "*docker logout *": "deny",
      "*docker logout": "deny",
      "*git merge *": "deny",
      "*git merge": "deny",
      "*security add-*": "deny",
      "*security delete-*": "deny"
    }
  }
}
