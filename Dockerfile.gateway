# LiteLLM proxy + the Switchyard plugin. The generated LiteLLM config is built at
# container start from config/plans.yaml, so there is one file to edit.
#
# This image is venv-based (/app/.venv) and ships NO pip — `pip install` here
# fails with "pip: not found". It does not need one: every dependency Switchyard
# uses (pyyaml, redis, fastapi, httpx, jinja2) is already in that venv, because
# LiteLLM itself depends on them. The RUN below asserts that rather than assuming
# it, so a base-image change fails the build with a clear message instead of an
# ImportError at request time.
#
# Switchyard lives in /switchyard, not /app: /app is the image's own application
# directory and copying into it risks clobbering LiteLLM's files.
#
# PIN POLICY: litellm is pinned by tag AND digest together. The tag is what
# humans read; the digest is what `docker pull` actually fetches. They MUST
# move together — bumping the tag without the digest silently pulls whatever
# the registry has at that tag today, and switching the digest (which is
# content-addressed) without the tag is impossible. Upgrading litellm is a
# deliberate commit: re-pin both, then `python -m switchyard.selfcheck` on a
# running image to confirm the pre-routing-hook is still internal-only, the
# pre-call-hook still fires, and num_retries=0 still produces one attempt.
FROM ghcr.io/berriai/litellm:v1.101.0@sha256:d295634e09c648dcdb72c4cc2dd226f5fb87823a73e88cbbed6f205e4deb044b

RUN python3 - <<'PY'
import importlib, sys
required = {"yaml": "pyyaml", "redis": "redis", "fastapi": "fastapi",
            "litellm": "litellm"}
missing = []
for module, package in required.items():
    try:
        importlib.import_module(module)
    except ImportError:
        missing.append(package)
if missing:
    sys.exit(
        "Switchyard needs these packages, and this base image no longer ships "
        f"them: {', '.join(missing)}. The image has no pip, so either pin a base "
        "image that includes them or add a build stage that vendors them into "
        "/app/.venv/lib/python3.*/site-packages."
    )
print("switchyard: base image provides every required package")
PY

# Patch litellm.litellm_core_utils.token_counter at build time so Anthropic
# tool schemas whose array property omits `items` do not break token counting.
#
# The Anthropic tool-input-schema spec does not require `items` on an array
# property - `{"type": "array"}` is a complete schema. OpenAI's schema does
# require it, and litellm's `_format_type` (inside token_counter.py) was
# written against the OpenAI shape: it does a bare-subscript
# `props['items']` in the `type == "array"` branch, which raises KeyError
# on every legitimate Anthropic `tools=[...]` payload the gateway receives
# and takes `token_counter` down with a stack trace on first use (issue
# #59). Note that `_format_function_definitions`, in the same file,
# already accepts an Anthropic-shaped schema via `input_schema` without
# insisting on `items`, so the omission is unambiguously legal upstream.
#
# The fix lives in the *counting* layer only: we replace the bare-subscript
# access with a tolerant `.get('items') or {'type': 'string'}` form, so an
# items-less array counts as `string[]` instead of raising. Tool definitions
# and the payloads we forward to the model are not touched.
#
# The exact-occurrence assert below is deliberate: this Dockerfile's PIN
# POLICY comment insists that any change to the FROM pin re-derives this
# patch. If a future pin bump silently drifts this line (renames the
# function, moves the branch, inlines the call, etc.), the bare-subscript
# comes back at request time as a KeyError - the same bug, with no commit
# message. Fail the build loudly here so the drift gets a name instead of
# an incident.
RUN python3 - <<'PY'
import os, sys

import litellm
pkg_dir = os.path.dirname(litellm.__file__)
target = os.path.join(pkg_dir, "litellm_core_utils", "token_counter.py")
if not os.path.isfile(target):
    sys.exit(f"switchyard: expected litellm token_counter.py at {target}")

with open(target, encoding="utf-8") as fh:
    src = fh.read()

# Vulnerable fragment: the `type == "array"` branch of `_format_type` does
# a bare-subscript `props['items']`. We expect this exact line - 8-space
# indent included, so the count is not artificially inflated by any
# docstring/comment that quotes the same expression - to appear EXACTLY
# once in the file.
vulnerable = "        return f\"{_format_type(props['items'], indent)}[]\""
count = src.count(vulnerable)
if count != 1:
    sys.exit(
        "switchyard: token_counter.py vulnerable fragment "
        "(props['items'] bare-subscript in _format_type) appeared "
        f"{count} times, expected 1. The pinned litellm base image has "
        "drifted past the patch; re-derive this patch against the new "
        "litellm pin before rebuilding, per the PIN POLICY at the top "
        "of Dockerfile.gateway."
    )

# Tolerant form: missing `items` (legal in the Anthropic tool spec) counts
# as `string[]` instead of raising KeyError. The recursive call into
# `_format_type` itself is unchanged, so the token-count shape for tools
# that *do* carry `items` (OpenAI-shaped schemas, mixed payloads, ...) is
# identical to the unpatched behaviour - the only thing the patch changes
# is the missing-`items` case.
patched = ("        return f\"{_format_type(props.get('items') or "
           "{'type': 'string'}, indent)}[]\"")
new_src = src.replace(vulnerable, patched, 1)
if new_src == src:
    sys.exit(
        "switchyard: token_counter.py replace() returned the same source; "
        "aborting rather than silently no-op'ing the patch."
    )

with open(target, "w", encoding="utf-8") as fh:
    fh.write(new_src)
print(
    "switchyard: token_counter.py patched (tolerant items[] access; "
    "items-less Anthropic arrays now render as 'string[]')"
)
PY

# Token counting for sidecar-backed deployments (issue #198). Every plan here
# is `openai/...` pointed at a SwitchYard CLI sidecar, so LiteLLM's
# OpenAITokenCounter forwards /v1/messages/count_tokens to
# {api_base}/responses/input_tokens. No sidecar serves that (a CLI cannot
# count), so every count 404'd, logged an ERROR, and THEN fell back to
# LiteLLM's local tokenizer - which is the number the client got anyway.
# Skip the doomed round trip: an api_base whose host ends in "-sidecar"
# returns None, which is LiteLLM's own "use the local counter" signal.
# Same answer the client already got, one less request and error line.
RUN python3 - <<'PY'
import os, sys
import litellm
target = os.path.join(os.path.dirname(litellm.__file__), "llms", "openai",
                      "responses", "count_tokens", "token_counter.py")
if not os.path.isfile(target):
    sys.exit(f"switchyard: expected {target}")
src = open(target, encoding="utf-8").read()
anchor = '        api_base: Final = litellm_params.get("api_base")\n'
if src.count(anchor) != 1:
    sys.exit("switchyard: count_tokens api_base anchor appeared "
             f"{src.count(anchor)} times, expected 1; re-derive the #198 patch")
guard = anchor + (
    "        try:\n"
    "            from urllib.parse import urlparse as _sy_urlparse\n"
    "            if (_sy_urlparse(api_base or '').hostname or '').endswith('-sidecar'):\n"
    "                return None  # switchyard #198: sidecars cannot count; count locally\n"
    "        except Exception:\n"
    "            pass\n")
open(target, "w", encoding="utf-8").write(src.replace(anchor, guard, 1))
print("switchyard: count_tokens patched (sidecar api_base -> local count)")
PY

COPY switchyard /switchyard/switchyard
COPY docker/gateway-entrypoint.sh /switchyard/entrypoint.sh
RUN chmod +x /switchyard/entrypoint.sh

ENV PYTHONPATH=/switchyard
ENV SWITCHYARD_PLANS=/switchyard/config/plans.yaml
WORKDIR /switchyard
EXPOSE 4000
ENTRYPOINT ["/switchyard/entrypoint.sh"]
