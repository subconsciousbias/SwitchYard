{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.backup.*)",
      "Edit(.env)",
      "Write(.env)",
      "Read(secrets/**)",
      "Bash(docker compose build *)",
      "Bash(docker compose up *)",
      "Bash(docker login *)",
      "Bash(docker logout *)",
      "Bash(security add-*)",
      "Bash(security delete-*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/guard.sh"
          }
        ]
      }
    ]
  }
}
