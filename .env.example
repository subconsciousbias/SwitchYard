# Switchyard secrets and host paths ONLY.
#
# Connection limits, model aliases, lane order, quotas and expiry dates all live
# in config/plans.yaml — never duplicate them here.
#
# To pick up new keys after a pull, run scripts/sync-env.sh. It appends missing
# keys and backs up your file; it never overwrites a value you have set.

# ---- compose project -------------------------------------------------------
# Names the docker-compose project. Worktrees have no .env (gitignored), so
# docker compose there fails closed with "run compose from the main checkout"
# instead of addressing the live `switchyard` project by accident — see
# CLAUDE.md and the `name: ${SWITCHYARD_PROJECT:?…}` line in docker-compose.yml.
# scripts/sync-env.sh appends this key to your operator .env on next run.
SWITCHYARD_PROJECT=switchyard

# ---- gateway ---------------------------------------------------------------
# what your tools authenticate with
LITELLM_MASTER_KEY=sk-switchyard-change-me
GATEWAY_PORT=4000
PORTAL_PORT=4001
GATEWAY_WORKERS=2
POSTGRES_PASSWORD=change-me

# ---- workhorse plans -------------------------------------------------------
MINIMAX_ULTRA_API_BASE=https://api.minimax.io/v1
MINIMAX_ULTRA_API_KEY=
MINIMAX_MAX_API_BASE=https://api.minimax.io/v1
MINIMAX_MAX_API_KEY=
GLM_API_BASE=https://api.z.ai/api/coding/paas/v4
GLM_API_KEY=
OPENROUTER_API_KEY=

# ---- judgement plans -------------------------------------------------------
# No keys here on purpose. Claude Max, the OpenAI seat (with Astra 6 / GPT 6 on
# it) and SuperGrok Heavy are all OAuth subscriptions — their CLIs hold the
# credentials, so there is nothing to paste. A Claude subscription does not
# grant API access, and the metered Fable plan ships disabled; set
# ANTHROPIC_API_KEY only if you deliberately add API credits and enable it.
# Likewise XAI_API_KEY is only for metered api.x.ai credits, which are separate
# billing from your SuperGrok subscription.

# ---- OpenAI $100 seat (OAuth, via sidecar — NOT an API key) -----------------
# A seat has no API key. The Codex CLI owns the login; point this at a host
# ~/.codex that is already logged in, or run `codex login` in the container.
# Defaults to ./secrets/codex; uncomment to share your host login instead.
# CODEX_CONFIG_DIR=$HOME/.codex
# Flags differ between Codex releases; check `codex exec --help` if calls fail.
CODEX_EXTRA_ARGS=

# ---- OpenCode-driven plans: SuperGrok + OpenCode Go (OAuth, via sidecars) ---
# Both use the OpenCode CLI's own logins — no API keys. They share these paths
# but run as separate processes, because their quotas are separate.
# Default to ./secrets/opencode/{data,config}. Sharing your host login DOES work
# for OpenCode (it is file-based), but the container will also write session
# databases and logs there. Uncomment to share.
# Path examples below use POSIX ~/. expansion. On Windows substitute
# %USERPROFILE% (e.g., %USERPROFILE%\.claude, %USERPROFILE%\.codex,
# %USERPROFILE%\.local\share\opencode, %USERPROFILE%\.config\opencode).
# OPENCODE_DATA_DIR=$HOME/.local/share/opencode
# OPENCODE_CONFIG_DIR=$HOME/.config/opencode
# A second Go subscription needs its own process AND its own login: plans.yaml
# points it at opencode-go2-sidecar (compose :8085), which defaults to
# ./secrets/opencode2/{data,config} — leave those defaults alone unless you
# deliberately want to share a login.
# OPENCODE2_DATA_DIR=$HOME/.local/share/opencode
# OPENCODE2_CONFIG_DIR=$HOME/.config/opencode
# Flags differ between OpenCode releases; check `opencode run --help` if calls fail.
OPENCODE_EXTRA_ARGS=
# The workspace ids the OpenCode console sends as `x-org-id`. Needed only by the
# Go plans' usage probes, which return {"code":"org_required"} without them —
# one per Go subscription. Find each in the console URL (/console/wrk_...) or
# from `GET https://opencode.ai/console/api/orgs`. Not credentials, but they
# name accounts, which is why they live here and not in the committed plans.yaml.
OPENCODE_ORG_ID=
OPENCODE_ORG_ID2=

# ---- Claude Max (OAuth, via sidecar) ---------------------------------------
# Credentials default to ./secrets/claude (isolated from your host CLI) — log in
# once with `docker compose exec claude-max-sidecar claude login`. Only set this
# to a host path if you have read secrets/README.md and accept the trade-off; on
# macOS the host token is in the Keychain and is not readable from the container.
# CLAUDE_CONFIG_DIR=$HOME/.claude
# On Linux the host token sits in the user's keyring (GNOME Keyring / KWallet,
# accessed by the CLI via `secret-tool`); on Windows it is in Windows
# Credential Manager (DPAPI-encrypted). Neither store is reachable from the
# container, so a host-path mount never carries credentials on those platforms.

# ---- local models ----------------------------------------------------------
# Ollama: http://host.docker.internal:11434/v1 · LM Studio: ...:1234/v1
LOCAL_API_BASE=http://host.docker.internal:11434/v1
# Many local servers (LM Studio, llama-swap, vLLM behind a proxy) require a key.
# If yours does not, any non-empty string works — LiteLLM needs something.
LOCAL_API_KEY=

# ---- sidecar tuning --------------------------------------------------------
# Defaults below are baked into the images (see sidecars/mcp_bridge/server.py).
# Override ONLY for an emergency hotfix; otherwise rebuild and redeploy so the
# new default reaches every container.
#
# A queued follow-up or rebuild on an MCP sidecar waits at most this long for a
# free slot on its plan before 503+Retry-After. A long value holds a gateway
# plan slot while doing no model work, and a queued rebuild of a pinned session
# starves that session's own follow-ups against the same plan (issue #14).
# MCP_RESUME_WAIT_SECONDS=15
