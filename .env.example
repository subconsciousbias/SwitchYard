# Switchyard secrets and host paths ONLY.
#
# Connection limits, model aliases, lane order, quotas and expiry dates all live
# in config/plans.yaml — never duplicate them here.
#
# To pick up new keys after a pull, run scripts/sync-env.sh. It appends missing
# keys and backs up your file; it never overwrites a value you have set.

# ---- gateway ---------------------------------------------------------------
# what your tools authenticate with
LITELLM_MASTER_KEY=sk-switchyard-change-me
GATEWAY_PORT=4000
PORTAL_PORT=4001
GATEWAY_WORKERS=2
POSTGRES_PASSWORD=change-me

# ---- workhorse plans -------------------------------------------------------
MINIMAX_ULTRA_API_BASE=https://api.minimax.io/v1
MINIMAX_ULTRA_API_KEY=
MINIMAX_MAX_API_BASE=https://api.minimax.io/v1
MINIMAX_MAX_API_KEY=
GLM_API_BASE=https://api.z.ai/api/coding/paas/v4
GLM_API_KEY=
OPENROUTER_API_KEY=

# ---- judgement plans -------------------------------------------------------
# No keys here on purpose. Claude Max, the OpenAI seat (with Astra 6 / GPT 6 on
# it) and SuperGrok Heavy are all OAuth subscriptions — their CLIs hold the
# credentials, so there is nothing to paste. A Claude subscription does not
# grant API access, and the metered Fable plan ships disabled; set
# ANTHROPIC_API_KEY only if you deliberately add API credits and enable it.
# Likewise XAI_API_KEY is only for metered api.x.ai credits, which are separate
# billing from your SuperGrok subscription.

# ---- OpenAI $100 seat (OAuth, via sidecar — NOT an API key) -----------------
# A seat has no API key. The Codex CLI owns the login; point this at a host
# ~/.codex that is already logged in, or run `codex login` in the container.
# Defaults to ./secrets/codex; uncomment to share your host login instead.
# CODEX_CONFIG_DIR=/Users/temporalis/.codex
# Flags differ between Codex releases; check `codex exec --help` if calls fail.
CODEX_EXTRA_ARGS=

# ---- OpenCode-driven plans: SuperGrok + OpenCode Go (OAuth, via sidecars) ---
# Both use the OpenCode CLI's own logins — no API keys. They share these paths
# but run as separate processes, because their quotas are separate.
# Default to ./secrets/opencode/{data,config}. Sharing your host login DOES work
# for OpenCode (it is file-based), but the container will also write session
# databases and logs there. Uncomment to share.
# OPENCODE_DATA_DIR=/Users/temporalis/.local/share/opencode
# OPENCODE_CONFIG_DIR=/Users/temporalis/.config/opencode
# Flags differ between OpenCode releases; check `opencode run --help` if calls fail.
OPENCODE_EXTRA_ARGS=
# The workspace id the OpenCode console sends as `x-org-id`. Needed only by the
# Go plan's usage probe, which returns {"code":"org_required"} without it. Find
# it in the console URL (/console/wrk_...) or from
# `GET https://opencode.ai/console/api/orgs`. Not a credential, but it names your
# account, which is why it is here and not in the committed plans.yaml.
OPENCODE_ORG_ID=

# ---- Claude Max (OAuth, via sidecar) ---------------------------------------
# Credentials default to ./secrets/claude (isolated from your host CLI) — log in
# once with `docker compose exec claude-max-sidecar claude login`. Only set this
# to a host path if you have read secrets/README.md and accept the trade-off; on
# macOS the host token is in the Keychain and is not readable from the container.
# CLAUDE_CONFIG_DIR=/Users/temporalis/.claude

# ---- local models ----------------------------------------------------------
# Ollama: http://host.docker.internal:11434/v1 · LM Studio: ...:1234/v1
LOCAL_API_BASE=http://host.docker.internal:11434/v1
# Many local servers (LM Studio, llama-swap, vLLM behind a proxy) require a key.
# If yours does not, any non-empty string works — LiteLLM needs something.
LOCAL_API_KEY=
